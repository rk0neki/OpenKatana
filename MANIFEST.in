include LICENSE NOTICE THIRD_PARTY_NOTICES.md README.md SECURITY.md requirements-lock.txt __init__.py
recursive-include licenses *.txt
include AGENTS.md mcp.example.json
recursive-include openkatana/web *.js *.html *.css *.jpg
recursive-include openkatana/web/vendor3d *
recursive-include comfy_nodes *.py *.js *.json
recursive-include workflows *.json
recursive-include docs *.md *.json
recursive-include tests *.py
recursive-include scripts *.py
recursive-include examples *.py *.json *.js *.txt *.md *.jpg *.wav *.mp4
prune work
prune .venv
global-exclude __pycache__ *.pyc
recursive-include openkatana/fonts *.ttf *.txt *.json
recursive-include openkatana/models *.onnx *.txt

exclude docs/SESSION_HANDOFF.md docs/NEXT_SESSION_CONTEXT.md
include CONTRIBUTING.md
recursive-include .github *.yml

recursive-include docs/assets *.png *.gif *.mp4

recursive-include openkatana/templates *.py *.js
recursive-include skills *.md

include .dockerignore
recursive-include deploy *.json *.worker *.service *.md Caddyfile
