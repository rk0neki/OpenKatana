[Unit]
Description=OpenKatana hosted web and MCP
After=network.target

[Service]
User=openkatana
Group=openkatana
WorkingDirectory=/opt/openkatana
ExecStart=/opt/openkatana/.venv/bin/openkatana-hosted --config /etc/openkatana/hosting.json web
Restart=on-failure
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/openkatana

[Install]
WantedBy=multi-user.target
